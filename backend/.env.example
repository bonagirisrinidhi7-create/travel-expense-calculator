# ========================================================
# Backend Environment Configuration Template
# ========================================================
# NOTE: Spring Boot reads standard system/terminal environment
# variables directly (e.g. via PowerShell `$env:VARIABLE = "value"`
# or Bash `export VARIABLE="value"`). Spring Boot does NOT
# automatically load `.env` files without specialized third-party
# libraries. This template is provided for reference only.
# ========================================================

# MySQL Host (default: localhost)
DB_HOST=localhost

# MySQL Port (default: 3306)
DB_PORT=3306

# MySQL Database Username (default: root)
DB_USERNAME=root

# MySQL Database Password (set in terminal session prior to running)
DB_PASSWORD=your_mysql_password_here
