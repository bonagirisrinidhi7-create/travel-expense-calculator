# ========================================================
# Backend Environment Configuration Template
# ========================================================
# NOTE: Spring Boot reads standard system/terminal environment
# variables directly (e.g. via PowerShell `$env:VARIABLE = "value"`
# or Bash `export VARIABLE="value"`). Spring Boot does NOT
# automatically load `.env` files without specialized third-party
# libraries. This template is provided for reference only.
# ========================================================

# Server Port (default: 8080, automatically injected by Render/Railway)
PORT=8080

# CORS Allowed Origins (comma-separated for multiple origins, e.g. https://your-frontend.vercel.app)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Option A: Full Cloud JDBC URL (takes precedence if defined)
# DB_URL=jdbc:mysql://mysql-3065c057-bonagirisrinidhi7-3fbd.e.aivencloud.com:14130/defaultdb?sslMode=REQUIRED&serverTimezone=UTC

# Option B: Individual MySQL Parameters (Local or Cloud like Aiven)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_expense_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# SSL Configuration (Required for cloud databases like Aiven: DB_SSL_MODE=REQUIRED, DB_USE_SSL=true)
DB_SSL_MODE=PREFERRED
DB_USE_SSL=false

# Hibernate SQL logging (default: false for production)
SHOW_SQL=false
